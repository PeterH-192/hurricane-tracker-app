generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── AUTHENTICATION & USERS ─────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  role           String   @default("HOST") // OWNER, MANAGER, HOST, SERVER
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([restaurantId])
  @@index([email])
}

// ─── RESTAURANT ──────────────────────────────────────────────────

model Restaurant {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  timezone          String   @default("America/New_York")
  defaultTurnTime   Int      @default(90)
  maxPartySize      Int      @default(12)
  bookingWindowDays Int      @default(30)
  autoConfirm       Boolean  @default(false)
  sameDayCutoff     String   @default("16:00") // No same-day reservations after this time

  users             User[]
  tables            Table[]
  floorPlans        FloorPlan[]
  reservations      Reservation[]
  waitlistEntries   WaitlistEntry[]
  guests            Guest[]
  timeSlotConfigs   TimeSlotConfig[]
  sections          Section[]
  notifications     Notification[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── TIME SLOT CONFIGURATION ─────────────────────────────────────

model TimeSlotConfig {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        // 0=Sunday, 6=Saturday
  openTime     String     // "11:00"
  closeTime    String     // "22:00"
  slotDuration Int        @default(30)
  maxCovers    Int        @default(50)
  isActive     Boolean    @default(true)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
}

// ─── FLOOR PLAN ──────────────────────────────────────────────────

model FloorPlan {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  isActive      Boolean    @default(true)
  width         Int        @default(1200)
  height        Int        @default(800)
  backgroundUrl String?

  tables        Table[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId])
}

// ─── SECTIONS ────────────────────────────────────────────────────

model Section {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  color        String     @default("#3B82F6")

  tables       Table[]

  @@index([restaurantId])
}

// ─── TABLES ──────────────────────────────────────────────────────

model Table {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  floorPlanId   String?
  floorPlan     FloorPlan? @relation(fields: [floorPlanId], references: [id], onDelete: SetNull)
  sectionId     String?
  section       Section?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  label         String
  capacity      Int
  minCapacity   Int        @default(1)
  shape         String     @default("SQUARE") // ROUND, SQUARE, RECTANGLE
  seatingArea   String     @default("INDOOR") // INDOOR, OUTDOOR, BAR
  diningStatus  String     @default("AVAILABLE") // AVAILABLE, RESERVED, SEATED, APPETIZERS, ENTREES, DESSERT_CHECK, BUSSING

  // Floor plan positioning
  posX          Float      @default(0)
  posY          Float      @default(0)
  width         Float      @default(60)
  height        Float      @default(60)
  rotation      Float      @default(0)

  // Combine/split support
  combinedWithId String?
  combinedWith   Table?    @relation("TableCombination", fields: [combinedWithId], references: [id])
  combinedTables Table[]   @relation("TableCombination")

  // Status tracking
  seatedAt        DateTime?
  statusChangedAt DateTime?

  reservations    Reservation[] @relation("TableReservations")
  waitlistSeats   WaitlistEntry[] @relation("TableWaitlistSeats")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([restaurantId])
  @@index([floorPlanId])
  @@index([sectionId])
  @@index([diningStatus])
}

// ─── RESERVATIONS ────────────────────────────────────────────────

model Reservation {
  id              String   @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  guestId         String?
  guest           Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)

  guestName       String
  guestPhone      String
  guestEmail      String?
  partySize       Int
  date            DateTime
  time            String   // "19:00"
  duration        Int      @default(90)
  seatingPref     String?  // INDOOR, OUTDOOR, BAR
  specialRequests String?

  tableId         String?
  table           Table?   @relation("TableReservations", fields: [tableId], references: [id], onDelete: SetNull)

  status          String   @default("PENDING") // PENDING, CONFIRMED, SEATED, COMPLETED, CANCELLED, NO_SHOW
  confirmedAt     DateTime?
  seatedAt        DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  source          String   @default("online") // online, phone, walk-in
  notes           String?

  notifications   Notification[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([restaurantId, date])
  @@index([guestId])
  @@index([status])
  @@index([tableId])
  @@index([guestPhone])
}

// ─── WAITLIST ────────────────────────────────────────────────────

model WaitlistEntry {
  id              String   @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  guestId         String?
  guest           Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)

  guestName       String
  guestPhone      String
  partySize       Int
  seatingPref     String?
  notes           String?

  position        Int
  estimatedWait   Int?
  quotedWait      Int?
  status          String   @default("WAITING") // WAITING, NOTIFIED, READY, SEATED, CANCELLED, NO_SHOW

  trackingToken   String   @unique @default(cuid())

  assignedTableId String?
  assignedTable   Table?   @relation("TableWaitlistSeats", fields: [assignedTableId], references: [id], onDelete: SetNull)

  joinedAt        DateTime @default(now())
  notifiedAt      DateTime?
  seatedAt        DateTime?
  removedAt       DateTime?

  notifications   Notification[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([position])
  @@index([trackingToken])
  @@index([guestPhone])
}

// ─── GUESTS ──────────────────────────────────────────────────────

model Guest {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name          String
  phone         String
  email         String?

  tags          String   @default("[]") // JSON array
  allergies     String?
  dietaryNotes  String?
  preferences   String?
  internalNotes String?

  totalVisits   Int      @default(0)
  noShowCount   Int      @default(0)
  lastVisitDate DateTime?

  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([name])
  @@index([phone])
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────

model Notification {
  id              String   @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservationId   String?
  reservation     Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  waitlistEntryId String?
  waitlistEntry   WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)

  type            String   // RESERVATION_CONFIRMATION, RESERVATION_REMINDER, etc.
  channel         String   // SMS, EMAIL
  recipient       String
  message         String
  sentAt          DateTime @default(now())
  mockDelivered   Boolean  @default(true)

  @@index([restaurantId])
  @@index([reservationId])
  @@index([waitlistEntryId])
}
